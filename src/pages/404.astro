---
import { SEO } from "astro-seo";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

const title = "404 - Lost in Time";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description="The page you are looking for has drifted out of your focus window."
    />
  </head>
  <body class="bg-gray-900 m-0 p-0 overflow-hidden text-white font-['Inter',_sans-serif]">
    <div class="h-screen w-screen flex flex-col items-center justify-center relative overflow-hidden">
      
      {/* Decorative background elements */}
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-red-500/10 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-500/10 blur-[120px] rounded-full"></div>

      <div class="z-10 flex flex-col items-center text-center px-6">
        <div class="relative mb-8">
            <h1 class="text-[12rem] sm:text-[16rem] font-black leading-none tracking-tighter opacity-10 select-none font-['Bricolage_Grotesque',_sans-serif]">
                404
            </h1>
            <div class="absolute inset-0 flex items-center justify-center translate-y-4">
                <span class="text-8xl filter drop-shadow-2xl animate-float">🍅</span>
            </div>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold mb-4 tracking-tight font-['Bricolage_Grotesque',_sans-serif]">
            Lost in focus?
        </h2>
        <p class="text-white/50 max-w-sm mb-12 text-lg leading-relaxed">
            The page you're searching for has drifted out of your scheduled workspace.
        </p>

        <a 
          href="/" 
          class="group flex items-center gap-3 px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-xl border border-white/10 rounded-full font-bold transition-all hover:scale-105"
        >
          <svg className="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Workspace
        </a>
      </div>

      {/* Floating clock hands decorative animation */}
      <div class="absolute bottom-10 left-10 opacity-5 pointer-events-none">
         <div class="w-32 h-32 rounded-full border border-white flex items-center justify-center">
            <div class="w-1 h-12 bg-white rounded-full origin-bottom animate-clock-hand" style="animation-duration: 10s;"></div>
         </div>
      </div>
    </div>

    <style is:global>
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0); }
            50% { transform: translateY(-20px) rotate(10deg); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
    </style>
  </body>
</html>
